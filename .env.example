# ---------------------------------------------------------------- obrigatórias
# Sem estas quatro o sistema não sobe.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# A chave de serviço ignora RLS. Ela fica só no servidor: nunca num
# NEXT_PUBLIC_, nunca no navegador, nunca no git.
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com → API Keys. É o que move a AURA inteira.
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------- crons
# Segredo que os crons mandam no Authorization. Gere um novo com:
#   openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------- opcionais
# Modelo da IA. Em branco usa o padrão do código.
AURA_IA_MODEL=
WHATSAPP_IA_MODEL=

# WhatsApp oficial (API da Meta). Fica vazio quem usa o WhatsApp Web
# pelo QR, que é o caminho padrão do sistema.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_NUMEROS=

# Herança da base de conhecimento antiga. Hoje a AURA estuda os materiais
# pelo Claude; deixe vazio.
OPENAI_API_KEY=
