# Crons do AURA Sales OS numa VPS.
#
# Na Vercel isso vinha do vercel.json; numa VPS o vercel.json é ignorado e
# nada roda sozinho. Instale com:
#
#   sudo cp deploy/aura-crons /etc/cron.d/aura
#   sudo chmod 644 /etc/cron.d/aura
#   sudo systemctl restart cron
#
# Troque SEU_CRON_SECRET pelo mesmo valor do .env.local (variável CRON_SECRET).
# Os horários estão no fuso da máquina: rode `timedatectl` e, se a VPS não
# estiver em America/Sao_Paulo, ajuste com
#   sudo timedatectl set-timezone America/Sao_Paulo
# — é o mais simples, porque aí os horários abaixo são os de Brasília mesmo.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
CRON_SECRET=SEU_CRON_SECRET
ALVO=http://127.0.0.1:3000

# Deploy automático, de 2 em 2 minutos: se a main do GitHub mudou, roda o
# deploy.sh; se o build falhar, volta para o commit anterior. Log em
# /var/log/aura-deploy.log.
*/2 * * * * root bash /opt/aura/deploy/auto-deploy.sh

# Briefing do dia para cada vendedor, 7h da manhã.
0 7 * * * root curl -sS -m 300 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/briefing-do-dia >> /var/log/aura-cron.log 2>&1

# Lead parado volta para a fila, de 5 em 5 minutos.
*/5 * * * * root curl -sS -m 120 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/repassar-leads >> /var/log/aura-cron.log 2>&1

# Atendentes automáticos, de 5 em 5 minutos: o agente de IA do Instagram
# (direct sem resposta no tempo da loja) e o assistente do chat do site MF
# (visitante esperando mais que o tempo configurado).
*/5 * * * * root curl -sS -m 300 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/assistentes >> /var/log/aura-cron.log 2>&1

# Supervisão da AURA, 9h.
0 9 * * * root curl -sS -m 300 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/supervisao-aura >> /var/log/aura-cron.log 2>&1

# Cobrança da supervisora, 9h10, de segunda a sábado: quem vende e está
# zerado no mês em oportunidade, fechamento, atividade ou relacionamento
# responde o porquê no Meu Dia; o gestor lê no painel. Uma por pessoa por dia.
10 9 * * 1-6 root curl -sS -m 120 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/cobranca-supervisora >> /var/log/aura-cron.log 2>&1

# Relatório semanal de cada loja, sábado às 16h. Roda sábado de propósito: a
# janela vai de segunda até o fim do próprio sábado, então o que a loja vendeu
# no sábado entra no relatório que fala dessa semana.
0 16 * * 6 root curl -sS -m 300 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/gerar-relatorios >> /var/log/aura-cron.log 2>&1

# Relatório mensal do diretor: dia 1, 08h (a rota gera o mensal quando é dia 1).
0 8 1 * * root curl -sS -m 300 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/gerar-relatorios >> /var/log/aura-cron.log 2>&1

# Cobrança da meta do mês, 11h. A rota só age do dia 1 ao 7 e manda uma
# cobrança por pessoa por dia, então rodar todo dia é inofensivo e garante que
# quem entrar na equipe no meio da janela também seja cobrado.
0 11 * * * root curl -sS -m 120 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/cobrar-metas >> /var/log/aura-cron.log 2>&1

# Aprendizado da semana, domingo às 21h: a AURA relê as conversas de WhatsApp
# da semana e sugere ao gestor o que guardar (nada entra em uso sem
# aprovação). Era todo dia e as sugestões se acumulavam sem revisão; agora é
# semanal e PULA a rodada enquanto houver mais de 100 esperando o gestor.
0 21 * * 0 root curl -sS -m 300 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/aprendizado-do-dia >> /var/log/aura-cron.log 2>&1

# Equipe de agentes, de 10 em 10 minutos: roda, um de cada vez, os agentes
# cuja agenda manda rodar agora (a Diretora às 7h20 e 18h, o Guardião do
# Conhecimento às 23h30, os de função cada um no seu horário). Sem a
# migração 110 no banco a rota só responde "aguardando_migracao".
*/10 * * * * root curl -sS -m 300 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/agentes >> /var/log/aura-cron.log 2>&1

# Backup do banco todo dia às 22h. Guarda 7 diários e 4 domingos anteriores a
# eles — cerca de 30 dias de cobertura — em /opt/aura/.backups.
0 22 * * * root curl -sS -m 300 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/backup >> /var/log/aura-cron.log 2>&1

# Sentinelas (operação, dados e segurança), 7h30 e 13h30: conferem se os
# crons rodaram, se o backup está na nuvem, se a IA responde, se há lead
# parado, negócio fora do pipeline, tabela sem RLS ou gestor mestre novo, e
# avisam os gestores mestres no sino. Só avisam o que for novo; a tela é
# Gestor › Saúde do sistema.
30 7,13 * * * root curl -sS -m 300 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/sentinela >> /var/log/aura-cron.log 2>&1

# Os logs do AURA crescem para sempre sem isto: todo domingo às 4h, o que
# passou de 50 MB é zerado. Vale para os crons, para o log do serviço
# (aura.log, que o systemd só acrescenta e nunca gira) e para o do deploy
# automático (aura-deploy.log, que ganha linhas a cada deploy).
0 4 * * 0 root find /var/log -maxdepth 1 \( -name 'aura-cron.log' -o -name 'aura.log' -o -name 'aura-deploy.log' \) -size +50M -exec truncate -s 0 {} \;
