# Crons do AURA Sales OS numa VPS.
#
# Na Vercel isso vinha do vercel.json; numa VPS o vercel.json é ignorado e
# nada roda sozinho. Instale com:
#
#   sudo cp deploy/aura-crons /etc/cron.d/aura
#   sudo chmod 644 /etc/cron.d/aura
#   sudo systemctl restart cron
#
# Troque SEU_CRON_SECRET pelo mesmo valor do .env.local (variável CRON_SECRET).
# Os horários estão no fuso da máquina: rode `timedatectl` e, se a VPS não
# estiver em America/Sao_Paulo, ajuste com
#   sudo timedatectl set-timezone America/Sao_Paulo
# — é o mais simples, porque aí os horários abaixo são os de Brasília mesmo.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
CRON_SECRET=SEU_CRON_SECRET
ALVO=http://127.0.0.1:3000

# Briefing do dia para cada vendedor, 7h da manhã.
0 7 * * * root curl -sS -m 300 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/briefing-do-dia >> /var/log/aura-cron.log 2>&1

# Lead parado volta para a fila, de 5 em 5 minutos.
*/5 * * * * root curl -sS -m 120 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/repassar-leads >> /var/log/aura-cron.log 2>&1

# Supervisão da AURA, 9h.
0 9 * * * root curl -sS -m 300 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/supervisao-aura >> /var/log/aura-cron.log 2>&1

# Relatório semanal de cada loja, sábado às 16h. Roda sábado de propósito: a
# janela vai de segunda até o fim do próprio sábado, então o que a loja vendeu
# no sábado entra no relatório que fala dessa semana.
0 16 * * 6 root curl -sS -m 300 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/gerar-relatorios >> /var/log/aura-cron.log 2>&1

# Relatório mensal do diretor: dia 1, 08h (a rota gera o mensal quando é dia 1).
0 8 1 * * root curl -sS -m 300 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/gerar-relatorios >> /var/log/aura-cron.log 2>&1

# Cobrança da meta do mês, 11h. A rota só age do dia 1 ao 7 e manda uma
# cobrança por pessoa por dia, então rodar todo dia é inofensivo e garante que
# quem entrar na equipe no meio da janela também seja cobrado.
0 11 * * * root curl -sS -m 120 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/cobrar-metas >> /var/log/aura-cron.log 2>&1

# Backup do banco todo dia às 22h. Guarda 7 diários e 4 domingos anteriores a
# eles — cerca de 30 dias de cobertura — em /opt/aura/.backups.
0 22 * * * root curl -sS -m 300 -H "Authorization: Bearer $CRON_SECRET" $ALVO/api/cron/backup >> /var/log/aura-cron.log 2>&1
