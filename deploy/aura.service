# Serviço do AURA Sales OS.
#
#   sudo cp deploy/aura.service /etc/systemd/system/aura.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aura
#   sudo systemctl status aura
#
# Ajuste User, WorkingDirectory e o caminho do node se a sua VPS for diferente.

[Unit]
Description=AURA Sales OS
After=network.target

[Service]
Type=simple
User=aura
WorkingDirectory=/opt/aura
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/opt/aura/.env.local
# Só escuta em 127.0.0.1: quem fala com a internet é o nginx (HTTPS). Antes o
# `next start` abria a porta 3000 em todos os endereços, e quem batesse direto
# em http://IP:3000 pulava o HTTPS e mandava o X-Forwarded-For que quisesse —
# o limite de envios por IP do site e do chat virava enfeite.
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1
Restart=always
RestartSec=5

# O WhatsApp guarda a sessão em disco. Se esta pasta sumir, o QR precisa ser
# lido de novo — por isso ela fica fora de qualquer limpeza de deploy.
# O "-" na frente é obrigatório: numa VPS nova a pasta ainda não existe (as
# sessões só chegam na troca, passo 6 do docs/vps-nova.md) e, sem ele, o
# systemd recusa subir o serviço (status=226/NAMESPACE) já no primeiro deploy.
ReadWritePaths=-/opt/aura/.whatsapp-sessions

StandardOutput=append:/var/log/aura.log
StandardError=append:/var/log/aura.log

[Install]
WantedBy=multi-user.target
